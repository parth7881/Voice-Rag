# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_xi_gu_hi_validation_v1
MSMARCO_DATASET=ai4bharat/MSMARCO-XI
MSMARCO_REVISION=main
DENSE_MODEL=intfloat/multilingual-e5-small
SPARSE_MODEL=Qdrant/bm25
DENSE_VECTOR_NAME=dense
SPARSE_VECTOR_NAME=sparse
INDEX_BATCH_SIZE=32
PARQUET_BATCH_SIZE=16

# Part 3 grounded generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=6
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=7000

# Part 4 voice
SARVAM_API_KEY=

# Later production layers
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_ENCRYPTION_KEY=
