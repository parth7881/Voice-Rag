{
  "name": "goa-voice-windows",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-icon": "node generate-icon.cjs",
    "dist": "npm run prepare-icon && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.goavoice.desktop",
    "productName": "Goa Voice",
    "artifactName": "GoaVoice-Setup-${version}.${ext}",
    "files": [
      "main.cjs",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Goa Voice",
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
